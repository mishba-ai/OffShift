    {
      "name": "login-manager",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Response status code is 200\", function () {\r",
              "    pm.expect(pm.response.code).to.equal(200);\r",
              "});\r",
              "\r",
              "const res = pm.response.json();\r",
              "if (res.token) {\r",
              "  pm.environment.set(\"token\", res.token);\r",
              "  console.log(\"Token saved:\", res.token);\r",
              "}\r",
              "pm.environment.set(\"token\", res.token);  // must match exactly, including the hyphen\r",
              "pm.test(\"Response time is less than 200ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(200);\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"Response has the required fields - token and role\", function () {\r",
              "    const responseData = pm.response.json();\r",
              "    \r",
              "    pm.expect(responseData).to.be.an('object');\r",
              "    pm.expect(responseData).to.have.all.keys('token', 'role');\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"Token is a non-empty string\", function () {\r",
              "    const responseData = pm.response.json();\r",
              "    \r",
              "    pm.expect(responseData).to.be.an('object');\r",
              "    pm.expect(responseData.token).to.exist.and.to.be.a('string').and.to.have.lengthOf.at.least(1, \"Token should not be empty\");\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"Role is one of the expected values\", function () {\r",
              "    const responseData = pm.response.json();\r",
              "    const expectedRoles = [\"EMPLOYEE\", \"MANAGER\"];\r",
              "    \r",
              "    pm.expect(responseData).to.be.an('object');\r",
              "    pm.expect(responseData.role).to.exist;\r",
              "    pm.expect(expectedRoles).to.include(responseData.role);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
